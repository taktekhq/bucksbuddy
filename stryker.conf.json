{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.config.ts" },
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/lib/money.ts",
    "src/lib/dates.ts",
    "src/lib/gold.ts",
    "src/lib/history.ts",
    "src/lib/stats.ts"
  ],
  "concurrency": 4,
  "timeoutMS": 20000
}
