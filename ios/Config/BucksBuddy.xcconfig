// Build settings shared by the app and its tests.
//
// The Supabase project is the same one the web app uses. The host is written
// without "https://" because `//` starts a comment in an .xcconfig file; the
// app adds the scheme. The anon key is public (it ships in the web bundle
// too) but isn't kept in the repo: put it in Secrets.xcconfig, which is
// git-ignored. Copy Secrets.example.xcconfig to get started.

SUPABASE_HOST = bucksbuddy.supabase.co
SUPABASE_ANON_KEY =

// The App Store / TestFlight identifier. Override it (and set your team) in
// Secrets.xcconfig to run a personal build on a device.
BB_BUNDLE_ID = io.taktek.bucksbuddy
DEVELOPMENT_TEAM =

#include? "Secrets.xcconfig"
