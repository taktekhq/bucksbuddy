{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // lib/crypto imports lib/pbkdf2 by its full filename so that node can load
    // it directly in scripts/crypto-interop.test.mts, which runs the mobile
    // crypto against the browser's without a bundler in the way.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}