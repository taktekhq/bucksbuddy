{
  "expo": {
    "name": "BucksBuddy",
    "slug": "bucksbuddy",
    "scheme": "bucksbuddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2F2F7",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F2F7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.taktek.bucksbuddy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.taktek.bucksbuddy",
      "adaptiveIcon": {
        "backgroundColor": "#F2F2F7",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Grobold.ttf"
          ]
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      "expo-localization",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "owner": "taktekhq",
    "extra": {
      "eas": {
        "projectId": "fd6e1661-5b7f-4109-a22e-e7f2725247a4"
      }
    }
  }
}