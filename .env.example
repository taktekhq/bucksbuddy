# Copy to .env.local for local dev, and set these in Vercel → Settings → Environment Variables.
# The app also accepts the older NEXT_PUBLIC_* names if you already set those.

# Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard → Project Settings → API → Project API keys → anon / public
VITE_SUPABASE_ANON_KEY=your-anon-key

# OPTIONAL: pre-fill the login email so you only type a password.
# The email is not secret; leave unset to show an email field instead.
# VITE_OWNER_EMAIL=you@email.com

# PostHog → Project Settings → Project API Key
VITE_POSTHOG_KEY=phc_your-project-api-key

# PostHog → Project Settings → Project API Key → API Host (region-specific)
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ---------------------------------------------------------------------------
# The paid spending review needs NO variable here, and must not be given one.
# Everything with a VITE_ or NEXT_PUBLIC_ prefix is inlined into the client
# bundle at build time, so a secret key in this file is a published secret.
#
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, ANTHROPIC_API_KEY and APP_URL all
# live in Supabase → Edge Functions → Secrets, where only the functions can
# read them. See "Spending reviews (paid)" in README.md.
# ---------------------------------------------------------------------------
